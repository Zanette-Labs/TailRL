# Copy to `.env` at the repo root and fill in. `.env` is gitignored.
# Every value below is also settable as a plain environment variable.

# --- REQUIRED ---------------------------------------------------------------
# Root of the ImageNet-1k localization release. Must contain:
#   LOC_train_solution.csv, LOC_val_solution.csv, ILSVRC/Data/CLS-LOC/{train,val}/
IMAGENET_DIR=/path/to/imagenet

# --- OPTIONAL: paths (repo-relative defaults shown) --------------------------
# TAILRL_ROOT=/path/to/TailRL
# TAILRL_RESULTS_DIR=${TAILRL_ROOT}/results/imagenet_localization
# TAILRL_FIGURES_DIR=${TAILRL_ROOT}/figures/imagenet_localization
# TAILRL_SWEEP_DIR=${TAILRL_ROOT}/experiments/imagenet_localization/sweep_scripts
# TAILRL_LOG_DIR=${TAILRL_SWEEP_DIR}/logs

# --- OPTIONAL: python environment -------------------------------------------
# TAILRL_CONDA_ENV=tailrl          # leave empty to skip `conda activate`
# TAILRL_PYTHON=/path/to/python    # defaults to $CONDA_PREFIX/bin/python, then `python`

# --- OPTIONAL: SLURM ---------------------------------------------------------
# TAILRL_SLURM_PARTITION=general
# TAILRL_SLURM_GRES=gpu:a6000:1
# TAILRL_SLURM_CPUS=8
# TAILRL_SLURM_MEM=32G
# TAILRL_SLURM_TIME=48:00:00

# --- OPTIONAL: Weights & Biases ---------------------------------------------
# Credentials come from ~/.netrc via `wandb login` — never put an API key here.
# WANDB_PROJECT=tailrl-imagenet-localization
# WANDB_ENTITY=your-entity
# WANDB_DIR=${TAILRL_ROOT}/wandb

# --- OPTIONAL: gui_grounding ------------------------------------------------
# Export these BEFORE running experiments/gui_grounding/scripts/prepare_data.sh, or ~54 GB of
# datasets and images lands inside the checkout. See that experiment's README.
# GUI_DATA_DIR=/scratch/you/gui_data      # the two parquets the trainer reads
# GUI_IMAGE_DIR=/scratch/you/gui_images   # becomes data.image_dir (~16 GB)
# GUI_RAW_DIR=/scratch/you/gui_raw        # raw HF downloads (~38 GB)
# BASE_MODEL=Qwen/Qwen2.5-VL-3B-Instruct  # or a local directory / a trained checkpoint
# TAILRL_GUI_SIF=/path/to/image.sif       # optional Apptainer image

# --- OPTIONAL: code_optimization -------------------------------------------
# Export these BEFORE running that experiment's scripts, or ~4 GB of test cases and
# a ~9 GB gem5 build land inside the checkout. See that experiment's README.
# PIE_TEST_CASE_DIR=/scratch/you/pie_test_cases   # the PIE test-case corpus (~3.4 GB)
# PIE_PARQUET_ROOT=/scratch/you/pie_parquet       # the built verl parquets (~21 MB)
# PIE_GEM5_HOME=/scratch/you/pie_gem5             # gem5 + sysroot + toolchain (~9 GB)
# CODEOPT_RUN_DIR=/scratch/you/codeopt_runs       # checkpoints, logs, evaluations
# BASE_MODEL=Qwen/Qwen3-1.7B                      # or a local directory
